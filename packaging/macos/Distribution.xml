<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>VirtualKVM</title>
  <welcome file="welcome.html" mime-type="text/html"/>
  <license file="license.txt" mime-type="text/plain"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>
  <options customize="never" require-scripts="false" hostArchitectures="$ARCHITECTURES"/>
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
  <volume-check>
    <allowed-os-versions><os-version min="$MINIMUM_OS"/></allowed-os-versions>
  </volume-check>
  <choices-outline><line choice="virtualkvm"/></choices-outline>
  <choice id="virtualkvm" title="VirtualKVM" visible="false">
    <pkg-ref id="$IDENTIFIER"/>
  </choice>
  <pkg-ref id="$IDENTIFIER" version="$VERSION" onConclusion="none">VirtualKVM-component.pkg</pkg-ref>
</installer-gui-script>
